# =============================================
# ARISA Cloud Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in your values.

# Application
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Supabase PostgreSQL — pooler on port 6543)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
# Direct connection for Prisma migrations (port 5432, NOT pooler)
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Device Security
DEVICE_REGISTRATION_SECRET=change-me-to-a-secure-random-string-min-20-chars
DEVICE_TOKEN_SALT_ROUNDS=12

# Pairing
PAIRING_CODE_EXPIRY_MINUTES=10

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS (comma-separated production domains)
CORS_ORIGINS=https://arisa.app,https://admin.arisa.app

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_MS=30000
AI_USER_RATE_LIMIT_PER_MINUTE=10
AI_USER_RATE_LIMIT_PER_HOUR=100
